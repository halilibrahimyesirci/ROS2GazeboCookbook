<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rgc_diffdrive_teleop</name>
  <version>0.1.0</version>
  <description>
    Recipe 04: a differential-drive robot with an IMU in Gazebo Harmonic, driven
    from the keyboard, with odometry, TF and IMU bridged into ROS 2.
  </description>
  <maintainer email="halilibrahimyesirci@users.noreply.github.com">Halil İbrahim Yesirci</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/halilibrahimyesirci/ROS2GazeboCookbook</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
