<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rgc_nav2_basic</name>
  <version>0.3.0</version>
  <description>
    Recipe 09: drive the reference robot to a goal with the Nav2 stack, using
    slam_toolbox for the map and localization.
  </description>
  <maintainer email="halilibrahimyesirci@users.noreply.github.com">Halil İbrahim Yesirci</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/halilibrahimyesirci/ROS2GazeboCookbook</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rgc_slam</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
